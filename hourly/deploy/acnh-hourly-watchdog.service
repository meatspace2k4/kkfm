# User unit: ~/.config/systemd/user/acnh-hourly-watchdog.service
# Follows the hourly player's journal and runs the watchdog log monitor on it
# (stdin mode: 1 s tick, BGM_* / WEATHER_* anomalies, RADIO_OFFLINE on stream close).
# Status/flags go to $XDG_RUNTIME_DIR/kkfm-hourly (tmpfs); anomalies to the USB.
[Unit]
Description=KKFM hourly BGM log watchdog
After=acnh-hourly.service
Wants=acnh-hourly.service

[Service]
Type=simple
WorkingDirectory=/mnt/kkfm-usb/kkfm/hourly-build
RuntimeDirectory=kkfm-hourly
RuntimeDirectoryMode=0755
ExecStart=/bin/sh -c 'journalctl --user -u acnh-hourly.service -f -n 0 -o cat | /usr/bin/env python3 /mnt/kkfm-usb/kkfm/hourly-build/watchdog_run.py monitor-logs --stdin --unit acnh-hourly.service --out-dir /mnt/kkfm-usb/kkfm/hourly-build/watchdog/out'
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=default.target
