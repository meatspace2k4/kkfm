# User unit (no sudo needed): ~/.config/systemd/user/acnh-hourly.service
# Hourly BGM player, packed build, stream-only (the radio owns the DAC / FM chip).
[Unit]
Description=KKFM hourly BGM (stream only, port 8791)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/kkfm-usb/kkfm/hourly-build
ExecStart=/mnt/kkfm-usb/kkfm/hourly-build/hourly_bgm
Environment=ACNH_STREAM_PORT=8791
Environment=ACNH_LOCALHOST_ONLY=0
Environment=ACNH_DISABLE_DAC=1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
